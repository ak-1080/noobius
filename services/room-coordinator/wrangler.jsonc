{
  "name": "noobius-room-coordinator",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "NeighborhoodRoom" }],
  },
  "migrations": [
    { "tag": "rooms-v1", "new_sqlite_classes": ["NeighborhoodRoom"] },
  ],
  "vars": { "NOOBIUS_ROOM_AUTH_ENABLED": "false" },
  "dev": { "port": 3004, "ip": "127.0.0.1" },
}
