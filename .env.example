# Optional live holder verification. Keep the RPC credential server-side.
# Leave unconfigured until the real chain and exact contract are confirmed.
# Solana launch: set ecosystem=solana, the exact mint, decimals and a server RPC.
# Network is mainnet-beta or devnet; the adapter verifies its genesis hash.
NOOBIUS_TOKEN_ECOSYSTEM=
NOOBIUS_SOLANA_NETWORK=mainnet-beta
NOOBIUS_TOKEN_MINT=
NOOBIUS_TOKEN_CHAIN_ID=
NOOBIUS_TOKEN_CONTRACT=
NOOBIUS_TOKEN_DECIMALS=
NOOBIUS_TOKEN_RPC_URL=
NOOBIUS_TOKEN_THRESHOLD=888
NOOBIUS_TOKEN_CONFIRMATIONS=12
# Local development only; requires loopback URL and a development build.
# Has no effect when a valid live-token policy exists or in production builds.
NOOBIUS_LOCAL_REALM_TEST=false
# Initial multiplayer capacity. Tune from deployment measurements.
NOOBIUS_MAX_PLAYERS=50
# Emergency controls preserve saves, existing work, cancellation and claims.
NOOBIUS_ADMISSION_PAUSED=false
# Pause new GPU entries independently; existing live occupants may resume.
NOOBIUS_GPU_ADMISSION_PAUSED=false
NOOBIUS_TRADE_PAUSED=false
NOOBIUS_PROJECTS_PAUSED=false
# Explicit report reviewers only. Empty/malformed configuration grants no access.
# Comma-separated EVM addresses or case-sensitive solana:<base58 address> keys.
# Gameplay ranks and Operator licenses do not grant this permission.
NOOBIUS_MODERATOR_WALLETS=
# Server-only room coordinator authentication. Disabled until an owned room
# host AND supported private service ingress are configured and verified.
# The standalone Worker has its own config at services/room-coordinator/.
# Both servers must share the same private auth configuration; see docs/room-coordinator.md.
# Do not put this JSON, its keys or wallet session cookies in browser code.
NOOBIUS_ROOM_AUTH_ENABLED=false
# JSON fields: audience (exact HTTPS game origin), coordinatorOrigin (exact
# HTTPS room origin), activeKey (key ID), keys (1–2 IDs -> 64-char random hex).
# Keep empty here; configure genuine secrets through the server environment.
NOOBIUS_ROOM_AUTH_CONFIG=
# Owner-account production locks browser mutations/sign-in to this exact origin.
NOOBIUS_SITE_ORIGIN=

# Token checkout stays disabled until devnet end-to-end checks and mint confirmation.
NOOBIUS_PAYMENTS_ENABLED=false
# Public key of the separate application co-signer (does not hold player funds).
NOOBIUS_PAYMENT_SIGNER=
# Server SECRET: JSON mapping co-signer public keys to base64 64-byte keypairs.
# Keep old keys for pending payment recovery. Provision on game AND recovery Workers.
NOOBIUS_PAYMENT_KEYS=
